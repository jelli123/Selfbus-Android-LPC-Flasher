<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and higher (android:dataExtractionRules). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Device-local settings (active hardware profile) start fresh on a new install -->
        <exclude domain="sharedpref" path="lpc11xx_flasher_local.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lpc11xx_flasher_local.xml" />
    </device-transfer>
</data-extraction-rules>
